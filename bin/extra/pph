#!/usr/bin/env bash
set -e

## Description: shows proofs/partials/qualities per hour over the past N hours.

OPTSTR='gd:ts'
SHOW_GRAPH=false
SHOW_TABLE=false
SHOW_SUMMARY=false
DATA_COLS="PROOFS,QUALITIES,PARTIALS"

usage() {
  echo "Usage: $0 [-t] [-g] [-s] [-d DATA] [HOURS]"
  echo
  echo "  -t       Show table (default if no other display options)"
  echo "  -g       Show graphs (uplot)"
  echo "  -s       Show summary stats (Average/Total)"
  echo "  -d DATA  Select data columns to display (comma-separated)."
  echo "           Options: PROOFS, QUALITIES, PARTIALS, FARMING"
  echo "           Default: PROOFS,QUALITIES,PARTIALS"
  echo "           Note: FARMING is only applicable to graph mode."
  echo "  HOURS    Number of hours back to analyze (default: 24)"
}

# Parse options
while getopts "$OPTSTR" opt; do
  case "$opt" in
    g)
      SHOW_GRAPH=true
      ;;
    t)
      SHOW_TABLE=true
      ;;
    s)
      SHOW_SUMMARY=true
      ;;
    d)
      DATA_COLS="$OPTARG"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done
shift "$((OPTIND - 1))"

# Normalize DATA_COLS: uppercase and remove spaces
DATA_COLS=$(echo "$DATA_COLS" | tr '[:lower:]' '[:upper:]' | tr -d ' ')

# Default behavior: if no display flags are set, show Table + Summary
if [[ "$SHOW_GRAPH" == "false" && "$SHOW_TABLE" == "false" && "$SHOW_SUMMARY" == "false" ]]; then
  SHOW_TABLE=true
  SHOW_SUMMARY=true
fi

HOURS=${1:-24}

TMPOUT=$(mktemp /tmp/tmpXXXXXXXXXX)          # proofs
TMPOUT2=$(mktemp /tmp/tmp2XXXXXXXXXX)        # partials
TMPOUT3=$(mktemp /tmp/tmp3XXXXXXXXXX)        # combined CSV for multi-line graph
TMPOUT4=$(mktemp /tmp/tmp4XXXXXXXXXX)        # farming
TMPOUT5=$(mktemp /tmp/tmp5XXXXXXXXXX)        # qualities
TMPOUT_FARMING_EVENTS=$(mktemp /tmp/tmp.events.XXXXXX)

# We might generate more temp files for values, ensure they are cleaned
TMPOUT_VALS_P="$TMPOUT.val"
TMPOUT_VALS_Q="$TMPOUT5.val"
TMPOUT_VALS_R="$TMPOUT2.val"
TMPOUT_VALS_F="$TMPOUT4.val"
TMPOUT_HOURS="$TMPOUT.hours"

shutdown() {
  tput cnorm || true
  rm -f "$TMPOUT" "$TMPOUT2" "$TMPOUT3" "$TMPOUT4" "$TMPOUT5" "$TMPOUT_FARMING_EVENTS" \
        "$TMPOUT_VALS_P" "$TMPOUT_VALS_Q" "$TMPOUT_VALS_R" "$TMPOUT_VALS_F" "$TMPOUT_HOURS" \
        "${TMPOUT3}.max" "${TMPOUT3}.x" "${TMPOUT}.val_table" "${TMPOUT2}.val_table" "${TMPOUT5}.val_table" \
        "${TMPOUT3}.scaled"
}
trap shutdown EXIT

echo
echo "Calculating stats for the past $HOURS hours..."

_hours_back() {
  local i
  for ((i = 1; i <= HOURS; i++)); do
    date -d "$i hour ago" '+%FT%H'
  done
}

# Helper: sum all integer matches for a given pattern+files, or 0 if none.
_sum_rg_numbers() {
  local pattern=$1
  shift
  local matches

  matches=$(rg -INoP "$pattern" "$@" 2>/dev/null || true)
  if [[ -n $matches ]]; then
    printf '%s\n' "$matches" | paste -sd+ - | bc
  else
    printf '0'
  fi
}

# Helper: nicely print "timestamp  value"
_print_row() {
  local ts=$1
  local val=$2
  paste <(echo "$ts") <(printf '%6s\n' "$val")
}

findProofs() {
  _hours_back | while read -r H; do
    PROOFS=$(_sum_rg_numbers \
      "${H}.*Found \K[1-9]\d*(?= V1 proofs)" \
      ~/.chia/mainnet/log/*harvester-debug.log*)
    _print_row "$H" "$PROOFS"
  done | tac
}

findQualaties() {
  _hours_back | while read -r H; do
    QUALS=$(_sum_rg_numbers \
      "${H}.*Found \K[1-9]\d*(?= V2 qualities)" \
      ~/.chia/mainnet/log/*harvester-debug.log*)
    _print_row "$H" "$QUALS"
  done | tac
}

sentPartials() {
  _hours_back | while read -r H; do
    PARTIALS=$(rg -INc "${H}.*Submitting partial" \
      ~/.chia/mainnet/log/*farmer-debug.log* 2>/dev/null \
      | awk '{s+=$1} END{print s+0}')
    _print_row "$H" "$PARTIALS"
  done | tac
}

farmingStatus() {
  rg --no-filename 'Launching.*chia_farmer|Daemon Server stopping.*chia_farmer' \
    ~/.chia/mainnet/log/daemon-debug.log* 2>/dev/null \
    | sort >"$TMPOUT_FARMING_EVENTS" || true

  _hours_back | while read -r H; do
    LAST_EVENT=$(awk -v h="$H" '$1 < h' "$TMPOUT_FARMING_EVENTS" | tail -n1)
    FARMING_STATUS=0
    if [[ -n $LAST_EVENT ]] && [[ $LAST_EVENT == *"Launching"* ]]; then
      FARMING_STATUS=1
    fi
    _print_row "$H" "$FARMING_STATUS"
  done | tac
}

# Compute SUM / AVG / MAX for a series file (using column N, default 1)
seriesStats() {
  local file="$1"
  local col="${2:-1}"
  local vals max sum avg

  if [[ ! -s "$file" ]]; then
    # SUM AVG MAX
    echo "0 0 1"
    return
  fi

  vals=$(choose "$col" < "$file")

  max=$(printf '%s\n' "$vals" | sort -n | tail -n1)
  [[ -z $max || $max -eq 0 ]] && max=1

  sum=$(printf '%s\n' "$vals" | paste -sd+ - | bc)
  avg=$(echo "scale=0; $sum / $HOURS" | bc -l)

  echo "$sum $avg $max"
}

collectSelected() {
  IFS=',' read -ra COLS <<< "$DATA_COLS"
  for col in "${COLS[@]}"; do
    case "$col" in
      PROOFS)    findProofs >"$TMPOUT" & ;;
      QUALITIES) findQualaties >"$TMPOUT5" & ;;
      PARTIALS)  sentPartials >"$TMPOUT2" & ;;
      FARMING)
        # We need farming status if graph is requested OR if user asked for it specifically 
        # (though it's only useful in graph, we collect it if asked)
        farmingStatus >"$TMPOUT4" & 
        ;;
    esac
done
  wait
}

# Multi-series graph: dynamic columns
constructGraph() {
  # Prepare X axis (Time: -HOURS to -1)
  seq -"$HOURS" -1 > "${TMPOUT3}.x" 
  
  FILES_TO_PASTE="${TMPOUT3}.x"
  FARMING_COL_IDX=0
  CURRENT_COL=2 # 1 is X
  TITLE_PARTS=""
  
  IFS=',' read -ra COLS <<< "$DATA_COLS"
  for col in "${COLS[@]}"; do
    case "$col" in
      PROOFS)
        choose 1 < "$TMPOUT" > "$TMPOUT_VALS_P"
        FILES_TO_PASTE="$FILES_TO_PASTE $TMPOUT_VALS_P"
        TITLE_PARTS="${TITLE_PARTS} Proofs / "
        ((CURRENT_COL++))
        ;;
      QUALITIES)
        choose 1 < "$TMPOUT5" > "$TMPOUT_VALS_Q"
        FILES_TO_PASTE="$FILES_TO_PASTE $TMPOUT_VALS_Q"
        TITLE_PARTS="${TITLE_PARTS}Qualities / "
        ((CURRENT_COL++))
        ;;
      PARTIALS)
        choose 1 < "$TMPOUT2" > "$TMPOUT_VALS_R"
        FILES_TO_PASTE="$FILES_TO_PASTE $TMPOUT_VALS_R"
        TITLE_PARTS="${TITLE_PARTS}Partials / "
        ((CURRENT_COL++))
        ;;
      FARMING)
        choose 1 < "$TMPOUT4" > "$TMPOUT_VALS_F"
        FILES_TO_PASTE="$FILES_TO_PASTE $TMPOUT_VALS_F"
        FARMING_COL_IDX=$CURRENT_COL
        TITLE_PARTS="${TITLE_PARTS}Farming (scaled) / "
        ((CURRENT_COL++))
        ;;
    esac
done
  
  # Remove trailing slash from title
  TITLE_PARTS=${TITLE_PARTS% / }
  
  # Check if we have any data
  if [[ "$FILES_TO_PASTE" == "${TMPOUT3}.x" ]]; then
    echo "No valid data columns selected for graph."
    return
  fi

  # Create CSV
  paste $FILES_TO_PASTE | tr '\t' ',' > "$TMPOUT3"

  # Scale farming if present
  if [[ $FARMING_COL_IDX -gt 0 ]]; then
      # Calculate MAX from other columns
      read MAX < <(awk -F',' -v fcol="$FARMING_COL_IDX" ' 
      {
          for(i=2;i<=NF;i++){
              if(i!=fcol){
                  if($i>m) m=$i
              }
          }
      }
      END { if(m=="" || m==0) m=1; print m }
      ' "$TMPOUT3")

      awk -F',' -v max="$MAX" -v fcol="$FARMING_COL_IDX" ' 
      {
          offline = (1 - $fcol);
          $fcol = offline * max;
          OFS=",";
          $1=$1; # rebuild record
          print $0;
      }' "$TMPOUT3" > "${TMPOUT3}.scaled"
      mv "${TMPOUT3}.scaled" "$TMPOUT3"
  fi

  # Plot
  cat "$TMPOUT3" \
    | uplot lines \
        -d , \
        --canvas braille \
        -w $(( "$(tput cols)" - 30 )) \
        -h 15 \
        --xlabel "Hour (oldest → newest)" \
        --ylabel "Count" \
        -t "$TITLE_PARTS"

  echo
}

printTable() {
  HEADER_LINE="Hour"
  FILES_TO_PASTE=""
  FIRST_ACTIVE=""

  IFS=',' read -ra COLS <<< "$DATA_COLS"
  for col in "${COLS[@]}"; do
    case "$col" in
      PROOFS)    FILE="$TMPOUT"; NAME=" Proofs" ;; 
      QUALITIES) FILE="$TMPOUT5"; NAME="Qualities" ;; 
      PARTIALS)  FILE="$TMPOUT2"; NAME="Partials" ;; 
      *) continue ;; # Skip farming or unknown in table
    esac

    if [[ -z "$FIRST_ACTIVE" ]]; then FIRST_ACTIVE="$FILE"; fi
    
    HEADER_LINE="$HEADER_LINE\t$NAME"
    choose 1 < "$FILE" > "${FILE}.val_table"
    FILES_TO_PASTE="$FILES_TO_PASTE ${FILE}.val_table"
  done

  if [[ -z "$FIRST_ACTIVE" ]]; then
    echo "No valid data columns selected for table (FARMING is graph-only)."
    return
  fi

  # Get Time column from the first available data file
  choose 0 < "$FIRST_ACTIVE" > "$TMPOUT_HOURS"
  
  # Calculate column count: 1 (Hour) + number of selected data columns
  # IFS=',' read -ra COLS <<< "$DATA_COLS" -> COLS is an array, ${#COLS[@]} is the count
  COL_COUNT=$(( ${#COLS[@]} + 1 ))

  {
    printf "%b\n" "$HEADER_LINE"
    paste "$TMPOUT_HOURS" $FILES_TO_PASTE
  } | ptable "$COL_COUNT" blue

  echo
}

printSummary() {
  IFS=',' read -ra COLS <<< "$DATA_COLS"
  for col in "${COLS[@]}"; do
    case "$col" in
      PROOFS)
        read SUM AVG _ < <(seriesStats "$TMPOUT")
        echo "Average proofs/hour: $AVG"
        echo "Total proofs:        $SUM"
        ;;
      QUALITIES)
        read SUM AVG _ < <(seriesStats "$TMPOUT5")
        echo "Average qualities/hr: $AVG"
        echo "Total qualities:      $SUM"
        ;;
      PARTIALS)
        read SUM AVG _ < <(seriesStats "$TMPOUT2")
        echo "Average partials/hr: $AVG"
        echo "Total partials:      $SUM"
        ;;
    esac
done
}

SPINNER=$(which spinner 2>/dev/null || true)
if [[ -n $SPINNER && -f $SPINNER ]]; then
  # shellcheck source=/dev/null
  source "$SPINNER"
else
  # Fallback: block until background jobs finish
  _spinner() { wait; }
fi

# Main Execution
collectSelected &
_spinner
echo -ne "\r"

if [[ $SHOW_TABLE == true ]]; then
  printTable
fi

if [[ $SHOW_GRAPH == true ]]; then
  constructGraph
fi

if [[ $SHOW_SUMMARY == true ]]; then
  printSummary
fi
